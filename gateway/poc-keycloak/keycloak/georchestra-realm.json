{
  "realm": "georchestra",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "loginTheme": "georchestra",
  "accountTheme": "georchestra",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "browserFlow": "browser_otp",
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "georchestra-ldap",
        "providerId": "ldap",
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "other"
          ],
          "connectionUrl": [
            "ldap://ldap:389"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "cn=admin,dc=georchestra,dc=org"
          ],
          "bindCredential": [
            "secret"
          ],
          "usersDn": [
            "ou=users,dc=georchestra,dc=org"
          ],
          "searchScope": [
            "1"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "entryUUID"
          ],
          "userObjectClasses": [
            "inetOrgPerson, organizationalPerson, person"
          ],
          "editMode": [
            "WRITABLE"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "true"
          ],
          "trustEmail": [
            "true"
          ],
          "pagination": [
            "true"
          ],
          "fullSyncPeriod": [
            "3600"
          ],
          "changedSyncPeriod": [
            "300"
          ],
          "cachePolicy": [
            "DEFAULT"
          ]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "uid"
                ],
                "user.model.attribute": [
                  "username"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "mail"
                ],
                "user.model.attribute": [
                  "email"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "givenName"
                ],
                "user.model.attribute": [
                  "firstName"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "sn"
                ],
                "user.model.attribute": [
                  "lastName"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ],
                "read.only": [
                  "false"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "full name (cn)",
              "providerId": "full-name-ldap-mapper",
              "config": {
                "ldap.full.name.attribute": [
                  "cn"
                ],
                "read.only": [
                  "false"
                ],
                "write.only": [
                  "true"
                ]
              }
            },
            {
              "name": "roles",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": [
                  "ou=roles,dc=georchestra,dc=org"
                ],
                "role.name.ldap.attribute": [
                  "cn"
                ],
                "role.object.classes": [
                  "groupOfMembers"
                ],
                "use.realm.roles.mapping": [
                  "true"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_ROLES_BY_MEMBER_ATTRIBUTE"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "mode": [
                  "LDAP_ONLY"
                ],
                "memberof.ldap.attribute": [
                  "memberOf"
                ]
              }
            },
            {
              "name": "organizations",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": [
                  "ou=orgs,dc=georchestra,dc=org"
                ],
                "group.name.ldap.attribute": [
                  "o"
                ],
                "group.object.classes": [
                  "groupOfMembers"
                ],
                "preserve.group.inheritance": [
                  "false"
                ],
                "ignore.missing.groups": [
                  "false"
                ],
                "mapped.group.attributes": [
                  "cn"
                ],
                "groups.path": [
                  "/"
                ],
                "drop.non.existing.groups.during.sync": [
                  "false"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "mode": [
                  "IMPORT"
                ],
                "memberof.ldap.attribute": [
                  "memberOf"
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "georchestra-gateway",
      "name": "geOrchestra gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "georchestra-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "usermodel.realmRoleMapping.rolePrefix": "ROLE_"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "organization",
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "group roles",
          "protocol": "openid-connect",
          "protocolMapper": "georchestra-group-roles",
          "consentRequired": false,
          "config": {
            "code.attribute": "cn",
            "role.prefix": "ROLE_GRP_",
            "claim.name": "group_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "datafeeder",
      "name": "Datafeeder backend (service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "datafeeder-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "geonetwork",
      "name": "GeoNetwork accounts synchronization (service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "geonetwork-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-datafeeder",
      "enabled": true,
      "serviceAccountClientId": "datafeeder",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-groups",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-geonetwork",
      "enabled": true,
      "serviceAccountClientId": "geonetwork",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-groups",
          "view-realm"
        ]
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 91,
      "config": {}
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "geOrchestra user (also grants access to the Keycloak account console)",
        "composite": true,
        "composites": {
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      },
      {
        "name": "MFA_REQUIRED",
        "description": "Second factor (TOTP) mandatory at password login, set up at next login. Included in SUPERUSER and GN_EDITOR; give it to a role, group or user to require MFA.",
        "composite": false
      },
      {
        "name": "SUPERUSER",
        "description": "geOrchestra super user (LDAP role), includes MFA_REQUIRED",
        "composite": true,
        "composites": {
          "realm": [
            "MFA_REQUIRED"
          ]
        }
      },
      {
        "name": "GN_EDITOR",
        "description": "GeoNetwork editor (LDAP role), includes MFA_REQUIRED",
        "composite": true,
        "composites": {
          "realm": [
            "MFA_REQUIRED"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "proconnect",
      "displayName": "ProConnect",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "https://fca.integ01.dev-agentconnect.fr/api/v2",
        "authorizationUrl": "https://fca.integ01.dev-agentconnect.fr/api/v2/authorize",
        "tokenUrl": "https://fca.integ01.dev-agentconnect.fr/api/v2/token",
        "userInfoUrl": "https://fca.integ01.dev-agentconnect.fr/api/v2/userinfo",
        "jwksUrl": "https://fca.integ01.dev-agentconnect.fr/api/v2/jwks",
        "logoutUrl": "https://fca.integ01.dev-agentconnect.fr/api/v2/session/end",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "e4128b426cf6b96b3cd6de4f6f405d7e3b2055e0e1dd40761c3219583a9bd3f4",
        "clientSecret": "5e645968f5233bbc5f631379c625b79ee2870afa19fb55cb5be37d3ce2b0738e",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid given_name usual_name email uid siret organization_label",
        "syncMode": "IMPORT",
        "sendIdTokenOnLogout": "true",
        "backchannelSupported": "false",
        "pkceEnabled": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username",
      "identityProviderAlias": "proconnect",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "template": "${CLAIM.email | lowercase}"
      }
    },
    {
      "name": "first name",
      "identityProviderAlias": "proconnect",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "last name",
      "identityProviderAlias": "proconnect",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "usual_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "email",
      "identityProviderAlias": "proconnect",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "geOrchestra USER role",
      "identityProviderAlias": "proconnect",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "role": "USER"
      }
    }
  ],
  "eventsListeners": [
    "jboss-logging",
    "georchestra-organization"
  ],
  "authenticatorConfig": [
    {
      "alias": "mfa_otp",
      "config": {
        "forceOtpRole": "MFA_REQUIRED",
        "defaultOtpOutcome": "skip"
      }
    },
    {
      "alias": "not_mfa_required",
      "config": {
        "condUserRole": "MFA_REQUIRED",
        "negate": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser_otp",
      "description": "Browser OTP based authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 26,
          "autheticatorFlow": true,
          "flowAlias": "browser_otp Organization",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "flowAlias": "browser_otp forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser_otp Browser - Conditional Organization",
      "description": "Flow to determine if the organization identity-first login is to be used",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "organization",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser_otp Organization",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "autheticatorFlow": true,
          "flowAlias": "browser_otp Browser - Conditional Organization",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser_otp forms",
      "description": "Username, password, otp and other auth forms.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorConfig": "mfa_otp",
          "authenticator": "auth-conditional-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 11,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "browser_otp voluntary OTP",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser_otp voluntary OTP",
      "description": "OTP for users without MFA_REQUIRED who configured one (MFA_REQUIRED users get it from the Conditional OTP Form)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "not_mfa_required",
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
