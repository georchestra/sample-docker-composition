# Copy this file to .env and provide local credentials.
# The .env file is ignored by Git and must never be committed.
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443
CADDY_ADMIN_PORT=2019
POSTGIS_PORT=5433
DESTINATION_GEONETWORK_URL=
DESTINATION_GEOSERVER_URL=
DESTINATION_DATAFEEDER_URL=
DESTINATION_LOGIN=
DESTINATION_PASSWORD=

